# iCalendar Feed Configuration (JSON array)
# REQUIRED: At least one calendar feed must be configured
ICAL_FEED_CONFIGS=[{"name":"Work","url":"https://work.ics"},{"name":"Personal","url":"https://personal.ics"}]

# Timezone for calendar events and current time (IANA timezone name)
# Examples: America/New_York, Europe/London, Asia/Tokyo, America/Los_Angeles
# Default: UTC
TIMEZONE=UTC

# Refresh interval in minutes
# Default: 60
REFRESH_INTERVAL=60

# Optional: Enable debug logging
# Default: false
DEBUG=false

# Cache Configuration (Optional - significantly improves performance)
# PostgreSQL cache (the service's own database; the table is created on first use)
# DATABASE_URL=postgresql://user:password@host:5432/calendar_mcp?sslmode=require&application_name=calendar-mcp

# Process-local cache for local development (takes precedence over DATABASE_URL)
# CACHE_BACKEND=memory

# Cache TTL Configuration (Optional - all values in seconds)
# Customize cache times based on your needs. Lower values = more fresh data but more API calls
# Calendar Cache Times
# CACHE_TTL_CALENDAR_EVENTS=900      # Calendar events (default: 900s/15min)
# CACHE_TTL_CALENDAR_INFO=1800       # Calendar info (default: 1800s/30min)

# Remote Server Configuration (for server_remote.py)
# HOST=0.0.0.0
# PORT=8080
# MCP_API_KEY=your-secure-api-key-here
# MD5_SALT=your-salt-here  # Optional: Salt for MD5 hash (recommended for security)
